FROM node:24-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
COPY backend/cmd/call/translation.go /backend/cmd/call/translation.go
COPY backend/cmd/call/main.go /backend/cmd/call/main.go
RUN npm run build \
    && npm run check:pwa \
    && npm run check:session \
    && npm run check:incoming-sound \
    && npm run check:onesignal \
    && npm run check:call-live

FROM nginx:1.27-alpine
COPY frontend-nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html
ENV PORT=8080
ENV BACKEND_URL=http://backend.railway.internal:8080
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
