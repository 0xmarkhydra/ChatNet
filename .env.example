# Auth
JWT_SECRET=replace-this-with-a-long-random-secret
OTP_PEPPER=replace-this-with-another-long-random-secret

# Email OTP via Resend
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
CHATNET_EMAIL_FROM=ChatNet <noreply@your-domain.com>

# AI Translation - provider agnostic
# Works with OpenAI-compatible providers. In auto mode ChatNet tries /responses,
# then falls back to /chat/completions when the provider does not support Responses API.
AI_PROVIDER=partner
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_STYLE=auto

# Most providers use Authorization: Bearer <key>.
# For x-api-key providers use:
# AI_AUTH_HEADER=x-api-key
# AI_AUTH_SCHEME=
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer

# S3-compatible storage — browser PUT thẳng lên object storage bằng presigned URL.
# ChatNet server chỉ lưu metadata + s3://bucket/key, không nhận byte file upload.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=true

# OneSignal Web Push
# App ID is public; REST API key stays server-side only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
