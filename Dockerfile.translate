FROM golang:1.23-alpine AS build
WORKDIR /src
COPY backend/go.mod ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/translate ./cmd/translate

FROM alpine:3.20
RUN adduser -D -H app
USER app
COPY --from=build /out/translate /translate
EXPOSE 8084
ENTRYPOINT ["/translate"]
