{
  "name": "chatnet-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:railway": "CHATNET_API_PROXY_TARGET=https://api-chat.codelocal.cloud VITE_API_PROXY=1 vite --host 0.0.0.0 --port 5188 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check:onesignal": "node --experimental-strip-types scripts/onesignal-init-check.mjs",
    "check:push-deeplink": "node scripts/push-notification-deeplink-check.mjs",
    "check:incoming-sound": "node --experimental-strip-types scripts/incoming-sound-check.mjs",
    "check:pwa": "node --experimental-strip-types scripts/pwa-update-check.mjs",
    "check:session": "node --experimental-strip-types scripts/session-check.mjs",
    "check:desktop-session": "node --experimental-strip-types scripts/desktop-session-check.mjs",
    "check:app-notifications": "node scripts/check-friends-redesign.mjs",
    "check:optimistic": "node --experimental-strip-types scripts/optimistic-check.mjs",
    "check:chat": "node --experimental-strip-types scripts/chat-persistence-check.mjs",
    "check:message-translation": "node --experimental-strip-types scripts/message-translation-view-check.mjs && node --experimental-strip-types scripts/chat-translation-settings-storage-check.mjs && node scripts/chat-translation-ui-check.mjs",
    "check:chat-layout": "node scripts/chat-layout-check.mjs",
    "check:adaptive-pwa": "node scripts/adaptive-pwa-check.mjs",
    "check:message-search": "node --experimental-strip-types scripts/message-search-check.mjs",
    "check:message-search-ui": "node scripts/message-search-zalo-ui-check.mjs",
    "check:outbox": "node --experimental-strip-types scripts/chat-outbox-check.mjs",
    "check:offline-browser": "node scripts/p0-02-offline-browser-check.mjs",
    "check:media": "node --experimental-strip-types scripts/media-upload-check.mjs",
    "check:chat-file-transfer": "node --experimental-strip-types scripts/chat-file-transfer-check.mjs",
    "check:message-clipboard": "node --experimental-strip-types scripts/message-clipboard-check.mjs",
    "check:message-clipboard-ui": "node scripts/message-clipboard-ui-check.mjs",
    "check:message-clipboard-browser": "node scripts/message-clipboard-browser-check.mjs",
    "check:chat-copy-image-proxy": "node --experimental-strip-types scripts/chat-copy-image-proxy-check.mjs",
    "check:voice": "node --experimental-strip-types scripts/voice-media-check.mjs",
    "check:ui": "node scripts/run-ui-layout.mjs",
    "check:social-ui": "node scripts/check-social-ui.mjs",
    "check:friends-redesign": "node scripts/check-friends-redesign.mjs",
    "check:groups-redesign": "node scripts/check-groups-redesign.mjs",
    "check:auth-redesign": "node scripts/check-auth-redesign.mjs",
    "check:call-ux": "node scripts/call-ux-check.mjs",
    "check:call-translation": "node --experimental-strip-types scripts/call-translation-check.mjs",
    "check:call-live": "node scripts/call-live-check.mjs",
    "preview": "vite preview",
    "check:categories": "node scripts/conversation-categories-check.mjs",
    "check:conversation-search": "node scripts/conversation-list-search-check.mjs",
    "check:profile-note": "node scripts/profile-note-check.mjs",
    "check:cache": "node --experimental-strip-types scripts/session-cache-check.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop --base ./ --outDir ../desktop/dist/renderer --emptyOutDir"
  },
  "dependencies": {
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.11.2",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "7.3.7"
  }
}