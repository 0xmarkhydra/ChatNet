server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    # Flutter bundles and assets can retain their names across deployments.
    # Revalidate instead of serving an obsolete bundle after a new release.
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    # Missing resources must not receive the HTML SPA shell.
    location ~ ^/(assets|canvaskit|icons)/ {
        try_files $uri =404;
    }
    location ~* \.(js|mjs|wasm|json|css|png|jpg|jpeg|svg|ico|woff2?|ttf|otf|map)$ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
